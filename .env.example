# Geofabrik regional extract used to build Valhalla routing tiles.
# Pick a small region that covers your test area.
# Browse extracts at https://download.geofabrik.de/
#
# IMPORTANT: use a direct, dated .osm.pbf URL, NOT the "-latest" alias.
# "-latest" is a redirect, and it silently downloads a tiny HTML redirect page
# instead of the real file in some Docker network setups. Get the direct URL
# by visiting the region's page (e.g. https://download.geofabrik.de/north-america/canada.html),
# right-clicking the region's download link, and copying the actual (dated) URL.
VALHALLA_REGION_NAME=british-columbia
VALHALLA_REGION_URL=https://download.geofabrik.de/north-america/canada/british-columbia-260927.osm.pbf

# Postgres
POSTGRES_USER=blackout
POSTGRES_PASSWORD=blackout
POSTGRES_DB=blackout
POSTGRES_PORT=5432
DATABASE_URL=postgres://blackout:blackout@localhost:5432/blackout

# API
API_PORT=8787

# Web
# 5173 is Vite's usual default; changed here since it's commonly already in use
# by other projects. This only affects the host-side port (the container's own
# dev server still listens on 5173 internally).
WEB_PORT=5180
VITE_API_URL=http://localhost:8787
VITE_DEFAULT_CENTER_LAT=49.2827
VITE_DEFAULT_CENTER_LNG=-123.1207

# Valhalla
VALHALLA_PORT=8002
VITE_VALHALLA_URL=http://localhost:8002
